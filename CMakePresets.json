{
  "version": 3,
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Dev (tests + compile_commands)",
      "description": "Local development: tests enabled, compile_commands.json generated",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "KAIROS_GRID_BUILD_TESTS": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "ci",
      "displayName": "CI",
      "description": "Continuous integration: tests enabled, Release build",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "KAIROS_GRID_BUILD_TESTS": "ON",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "release",
      "displayName": "Release (engine only)",
      "description": "Release build without tests",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "KAIROS_GRID_BUILD_TESTS": "OFF",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "plugin",
      "displayName": "CLAP plugin (dev)",
      "description": "Build the kairos-grid CLAP plugin with tests",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "KAIROS_GRID_BUILD_TESTS":  "ON",
        "KAIROS_GRID_BUILD_PLUGIN": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "mi",
      "displayName": "MI modules (dev)",
      "description": "Dev build with MI DSP wrappers (Plaits, SVF, OnePole). Set EURORACK_SRC_DIR to skip network fetch.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "KAIROS_GRID_BUILD_TESTS": "ON",
        "KAIROS_GRID_BUILD_MI":    "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "ci-mi",
      "displayName": "CI + MI modules",
      "description": "CI Release build with MI DSP wrappers enabled. Set EURORACK_SRC_DIR to skip network fetch.",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "KAIROS_GRID_BUILD_TESTS": "ON",
        "KAIROS_GRID_BUILD_MI":    "ON",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "surge",
      "displayName": "Surge XT (dev)",
      "description": "Dev build with Surge XT oscillator/filter/effect wrappers. Set SURGE_SRC_DIR to skip network fetch.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "KAIROS_GRID_BUILD_TESTS":  "ON",
        "KAIROS_GRID_BUILD_SURGE":  "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "ci-surge",
      "displayName": "CI + Surge XT",
      "description": "CI Release build with Surge XT wrappers enabled. Set SURGE_SRC_DIR to skip network fetch.",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "KAIROS_GRID_BUILD_TESTS":  "ON",
        "KAIROS_GRID_BUILD_SURGE":  "ON",
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev",      "configurePreset": "dev" },
    { "name": "ci",       "configurePreset": "ci" },
    { "name": "ci-mi",    "configurePreset": "ci-mi" },
    { "name": "release",  "configurePreset": "release" },
    { "name": "plugin",   "configurePreset": "plugin" },
    { "name": "mi",       "configurePreset": "mi" },
    { "name": "surge",    "configurePreset": "surge" },
    { "name": "ci-surge", "configurePreset": "ci-surge" }
  ],
  "testPresets": [
    { "name": "dev",      "configurePreset": "dev",      "output": { "outputOnFailure": true } },
    { "name": "ci",       "configurePreset": "ci",       "output": { "outputOnFailure": true } },
    { "name": "ci-mi",    "configurePreset": "ci-mi",    "output": { "outputOnFailure": true } },
    { "name": "mi",       "configurePreset": "mi",       "output": { "outputOnFailure": true } },
    { "name": "plugin",   "configurePreset": "plugin",   "output": { "outputOnFailure": true } },
    { "name": "surge",    "configurePreset": "surge",    "output": { "outputOnFailure": true } },
    { "name": "ci-surge", "configurePreset": "ci-surge", "output": { "outputOnFailure": true } }
  ]
}
