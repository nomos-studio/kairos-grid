{
  "version": 3,
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Dev (tests + compile_commands)",
      "description": "Local development: tests enabled, compile_commands.json generated",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "KAIROS_GRID_BUILD_TESTS": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "ci",
      "displayName": "CI",
      "description": "Continuous integration: tests enabled, Release build",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "KAIROS_GRID_BUILD_TESTS": "ON",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "release",
      "displayName": "Release (engine only)",
      "description": "Release build without tests",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "KAIROS_GRID_BUILD_TESTS": "OFF",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "plugin",
      "displayName": "CLAP plugin (dev)",
      "description": "Build the kairos-grid CLAP plugin with tests. Set CLAP_SRC_DIR to skip network fetch.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "KAIROS_GRID_BUILD_TESTS":  "ON",
        "KAIROS_GRID_BUILD_PLUGIN": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "mi",
      "displayName": "MI modules (dev)",
      "description": "Dev build with MI DSP wrappers (Plaits, SVF, OnePole). Set EURORACK_SRC_DIR to skip network fetch.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "KAIROS_GRID_BUILD_TESTS": "ON",
        "KAIROS_GRID_BUILD_MI":    "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "ci-mi",
      "displayName": "CI + MI modules",
      "description": "CI Release build with MI DSP wrappers enabled. Set EURORACK_SRC_DIR to skip network fetch.",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "KAIROS_GRID_BUILD_TESTS": "ON",
        "KAIROS_GRID_BUILD_MI":    "ON",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "surge",
      "displayName": "Surge XT (dev)",
      "description": "Dev build with Surge XT wrappers. Set SURGE_SRC_DIR (and SURGE_SIMDE_PATH if external tree) to skip network fetch. PLUGIN disabled: Surge bundles its own clap target via clap-juce-extensions, which collides with the plugin preset's FetchContent clap.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "KAIROS_GRID_BUILD_TESTS":  "ON",
        "KAIROS_GRID_BUILD_SURGE":  "ON",
        "KAIROS_GRID_BUILD_PLUGIN": "OFF",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "ci-surge",
      "displayName": "CI + Surge XT",
      "description": "CI Release build with Surge XT wrappers. PLUGIN disabled: see surge preset description.",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "KAIROS_GRID_BUILD_TESTS":  "ON",
        "KAIROS_GRID_BUILD_SURGE":  "ON",
        "KAIROS_GRID_BUILD_PLUGIN": "OFF",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "plugin-mi",
      "displayName": "CLAP plugin + MI modules (dev)",
      "description": "Build the kairos-grid CLAP plugin with MI DSP (Plaits, SVF) linked in. Set EURORACK_SRC_DIR to skip network fetch.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "KAIROS_GRID_BUILD_TESTS":  "ON",
        "KAIROS_GRID_BUILD_PLUGIN": "ON",
        "KAIROS_GRID_BUILD_MI":     "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "wasm",
      "displayName": "WASM modules (dev)",
      "description": "Dev build with Faust WASM module support (downloads wasmtime v44 pre-built binaries). Set KAIROS_GRID_BUILD_ENGINE=ON is implied.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "KAIROS_GRID_BUILD_TESTS": "ON",
        "KAIROS_GRID_BUILD_WASM":  "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "ci-wasm",
      "displayName": "CI + WASM modules",
      "description": "CI Release build with Faust WASM module support.",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "KAIROS_GRID_BUILD_TESTS": "ON",
        "KAIROS_GRID_BUILD_WASM":  "ON",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "plugin-wasm",
      "displayName": "CLAP plugin + WASM modules (dev)",
      "description": "Build the kairos-grid CLAP plugin with Faust WASM module support linked in.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "KAIROS_GRID_BUILD_TESTS":  "ON",
        "KAIROS_GRID_BUILD_PLUGIN": "ON",
        "KAIROS_GRID_BUILD_WASM":   "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "sanitize",
      "displayName": "Sanitize (ASan + UBSan)",
      "description": "Debug build with AddressSanitizer and UndefinedBehaviorSanitizer — gate 2 of CI; engine tests only (no plugin/MI/WASM/Surge)",
      "binaryDir": "${sourceDir}/build-san",
      "cacheVariables": {
        "KAIROS_GRID_BUILD_TESTS":  "ON",
        "CMAKE_BUILD_TYPE": "Debug",
        "NOMOS_SANITIZE": "address,undefined"
      }
    },
    {
      "name": "tsan",
      "displayName": "Sanitize (TSan)",
      "description": "Debug build with ThreadSanitizer — gate 3 of CI; engine tests only. TSan is mutually exclusive with ASan; UBSan is covered by the sanitize preset.",
      "binaryDir": "${sourceDir}/build-tsan",
      "cacheVariables": {
        "KAIROS_GRID_BUILD_TESTS":  "ON",
        "CMAKE_BUILD_TYPE": "Debug",
        "NOMOS_SANITIZE": "thread"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev",         "configurePreset": "dev" },
    { "name": "ci",          "configurePreset": "ci" },
    { "name": "ci-mi",       "configurePreset": "ci-mi" },
    { "name": "ci-wasm",     "configurePreset": "ci-wasm" },
    { "name": "sanitize",    "configurePreset": "sanitize" },
    { "name": "tsan",        "configurePreset": "tsan" },
    { "name": "release",     "configurePreset": "release" },
    { "name": "plugin",      "configurePreset": "plugin" },
    { "name": "mi",          "configurePreset": "mi" },
    { "name": "wasm",        "configurePreset": "wasm" },
    { "name": "surge",       "configurePreset": "surge" },
    { "name": "ci-surge",    "configurePreset": "ci-surge" },
    { "name": "plugin-mi",   "configurePreset": "plugin-mi" },
    { "name": "plugin-wasm", "configurePreset": "plugin-wasm" }
  ],
  "testPresets": [
    { "name": "dev",         "configurePreset": "dev",         "output": { "outputOnFailure": true } },
    { "name": "ci",          "configurePreset": "ci",          "output": { "outputOnFailure": true } },
    { "name": "ci-mi",       "configurePreset": "ci-mi",       "output": { "outputOnFailure": true } },
    { "name": "ci-wasm",     "configurePreset": "ci-wasm",     "output": { "outputOnFailure": true } },
    { "name": "sanitize",    "configurePreset": "sanitize",    "output": { "outputOnFailure": true } },
    { "name": "tsan",        "configurePreset": "tsan",        "output": { "outputOnFailure": true } },
    { "name": "mi",          "configurePreset": "mi",          "output": { "outputOnFailure": true } },
    { "name": "wasm",        "configurePreset": "wasm",        "output": { "outputOnFailure": true } },
    { "name": "plugin",      "configurePreset": "plugin",      "output": { "outputOnFailure": true } },
    { "name": "surge",       "configurePreset": "surge",       "output": { "outputOnFailure": true } },
    { "name": "ci-surge",    "configurePreset": "ci-surge",    "output": { "outputOnFailure": true } },
    { "name": "plugin-mi",   "configurePreset": "plugin-mi",   "output": { "outputOnFailure": true } },
    { "name": "plugin-wasm", "configurePreset": "plugin-wasm", "output": { "outputOnFailure": true } }
  ]
}
