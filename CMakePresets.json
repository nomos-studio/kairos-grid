{
  "version": 3,
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Dev (tests + compile_commands)",
      "description": "Local development: tests enabled, compile_commands.json generated",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "KAIROS_GRID_BUILD_TESTS": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "ci",
      "displayName": "CI",
      "description": "Continuous integration: tests enabled, Release build",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "KAIROS_GRID_BUILD_TESTS": "ON",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "release",
      "displayName": "Release (engine only)",
      "description": "Release build without tests",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "KAIROS_GRID_BUILD_TESTS": "OFF",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "plugin",
      "displayName": "CLAP plugin (dev)",
      "description": "Build the kairos-grid CLAP plugin with tests. Set CLAP_SRC_DIR to skip network fetch.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "KAIROS_GRID_BUILD_TESTS": "ON",
        "KAIROS_GRID_BUILD_PLUGIN": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "mi",
      "displayName": "MI modules (dev)",
      "description": "Dev build with MI DSP wrappers (Plaits, SVF, OnePole). Set EURORACK_SRC_DIR to skip network fetch.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "KAIROS_GRID_BUILD_TESTS": "ON",
        "KAIROS_GRID_BUILD_MI": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "ci-mi",
      "displayName": "CI + MI modules",
      "description": "CI Release build with MI DSP wrappers enabled. Set EURORACK_SRC_DIR to skip network fetch.",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "KAIROS_GRID_BUILD_TESTS": "ON",
        "KAIROS_GRID_BUILD_MI": "ON",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "airwindows",
      "displayName": "Airwindows (dev)",
      "description": "Dev build with Airwindows saturation module wrappers.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "KAIROS_GRID_BUILD_TESTS": "ON",
        "KAIROS_GRID_BUILD_AIRWINDOWS": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "ci-airwindows",
      "displayName": "CI + Airwindows",
      "description": "CI Release build with Airwindows saturation module wrappers.",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "KAIROS_GRID_BUILD_TESTS": "ON",
        "KAIROS_GRID_BUILD_AIRWINDOWS": "ON",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "surge",
      "displayName": "Surge XT (dev)",
      "description": "Dev build with Surge XT wrappers. Set SURGE_SRC_DIR (and SURGE_SIMDE_PATH if external tree) to skip network fetch. PLUGIN disabled: Surge bundles its own clap target via clap-juce-extensions, which collides with the plugin preset's FetchContent clap. macOS deployment target pinned to 14.0 so JUCE tools build cleanly on macOS 15 (CGWindowListCreateImage is deprecated on 14.0, unavailable on 15.0).",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "KAIROS_GRID_BUILD_TESTS": "ON",
        "KAIROS_GRID_BUILD_SURGE": "ON",
        "KAIROS_GRID_BUILD_PLUGIN": "OFF",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "14.0"
      }
    },
    {
      "name": "ci-surge",
      "displayName": "CI + Surge XT",
      "description": "CI Release build with Surge XT wrappers. PLUGIN disabled: see surge preset description. macOS deployment target pinned to 14.0; see surge preset description.",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "KAIROS_GRID_BUILD_TESTS": "ON",
        "KAIROS_GRID_BUILD_SURGE": "ON",
        "KAIROS_GRID_BUILD_PLUGIN": "OFF",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "14.0"
      }
    },
    {
      "name": "plugin-mi",
      "displayName": "CLAP plugin + MI modules (dev)",
      "description": "Build the kairos-grid CLAP plugin with MI DSP (Plaits, SVF) linked in. Set EURORACK_SRC_DIR to skip network fetch.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "KAIROS_GRID_BUILD_TESTS": "ON",
        "KAIROS_GRID_BUILD_PLUGIN": "ON",
        "KAIROS_GRID_BUILD_MI": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "wasm",
      "displayName": "WASM modules (dev)",
      "description": "Dev build with Faust WASM module support (downloads wasmtime v44 pre-built binaries). Set KAIROS_GRID_BUILD_ENGINE=ON is implied.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "KAIROS_GRID_BUILD_TESTS": "ON",
        "KAIROS_GRID_BUILD_WASM": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "ci-wasm",
      "displayName": "CI + WASM modules",
      "description": "CI Release build with Faust WASM module support.",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "KAIROS_GRID_BUILD_TESTS": "ON",
        "KAIROS_GRID_BUILD_WASM": "ON",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "plugin-wasm",
      "displayName": "CLAP plugin + WASM modules (dev)",
      "description": "Build the kairos-grid CLAP plugin with Faust WASM module support linked in.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "KAIROS_GRID_BUILD_TESTS": "ON",
        "KAIROS_GRID_BUILD_PLUGIN": "ON",
        "KAIROS_GRID_BUILD_WASM": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "fft",
      "displayName": "FFT modules (dev)",
      "description": "Dev build with KissFFT spectral analysis modules.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "KAIROS_GRID_BUILD_TESTS": "ON",
        "KAIROS_GRID_BUILD_FFT": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "ci-fft",
      "displayName": "CI + FFT modules",
      "description": "CI Release build with KissFFT spectral analysis modules.",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "KAIROS_GRID_BUILD_TESTS": "ON",
        "KAIROS_GRID_BUILD_FFT": "ON",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "wdf",
      "displayName": "WDF modules (dev)",
      "description": "Dev build with chowdsp_wdf circuit model modules.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "KAIROS_GRID_BUILD_TESTS": "ON",
        "KAIROS_GRID_BUILD_WDF": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "ci-wdf",
      "displayName": "CI + WDF modules",
      "description": "CI Release build with chowdsp_wdf circuit model modules.",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "KAIROS_GRID_BUILD_TESTS": "ON",
        "KAIROS_GRID_BUILD_WDF": "ON",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "sanitize",
      "displayName": "Sanitize (ASan + UBSan)",
      "description": "Debug build with AddressSanitizer and UndefinedBehaviorSanitizer \u2014 gate 2 of CI; engine + plugin tests (no MI/WASM/Surge)",
      "binaryDir": "${sourceDir}/build-san",
      "cacheVariables": {
        "KAIROS_GRID_BUILD_TESTS": "ON",
        "KAIROS_GRID_BUILD_PLUGIN": "ON",
        "CMAKE_BUILD_TYPE": "Debug",
        "NOMOS_SANITIZE": "address,undefined"
      }
    },
    {
      "name": "tsan",
      "displayName": "Sanitize (TSan)",
      "description": "Debug build with ThreadSanitizer \u2014 gate 3 of CI; engine + plugin tests. TSan is mutually exclusive with ASan; UBSan is covered by the sanitize preset.",
      "binaryDir": "${sourceDir}/build-tsan",
      "cacheVariables": {
        "KAIROS_GRID_BUILD_TESTS": "ON",
        "KAIROS_GRID_BUILD_PLUGIN": "ON",
        "CMAKE_BUILD_TYPE": "Debug",
        "NOMOS_SANITIZE": "thread"
      }
    }
  ],
